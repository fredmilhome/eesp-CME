# Processed data
/data/processed/*

# Generated outputs (figures, tables, logs)
/output/figures/*
/output/tables/*

# Keep folder structure tracked
!/output/figures/
!/output/tables/
!/output/figures/.gitignore
!/output/tables/.gitignore
!/data/raw/.gitignore
!/data/processed/.gitignore

# Julia local cache/artifacts that may appear in project folders
*.jl.cov
*.jl.mem
